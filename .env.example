# =============================================================================
# Nidhi Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# SECURITY: Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
APP_NAME="Nidhi Backend - Plaid Integration"
APP_VERSION="0.1.0"
API_HOST=0.0.0.0
API_PORT=8000

# Environment: development, staging, or production
# - development: Auto-enables DEBUG=true, allows localhost CORS
# - production: Enforces strict security requirements
ENVIRONMENT=development

# Debug mode (optional in development, auto-enabled if not set)
# IMPORTANT: Must be False in production (enforced by validator)
# DEBUG=false

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Get credentials from: https://app.supabase.com/project/_/settings/api
# REQUIRED in production environment
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# Plaid Configuration
# -----------------------------------------------------------------------------
# Get credentials from: https://dashboard.plaid.com/team/keys
# REQUIRED: Must be set to real values (validates against placeholder values)
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret

# Plaid environment: sandbox, development, or production
# - sandbox: Test with fake institutions (recommended for development)
# - development: Test with real institutions (limited to specific account)
# - production: Live data (requires Production Access approval from Plaid)
PLAID_ENV=sandbox

# Webhook URL for Plaid events (REQUIRED in production with PLAID_ENV=production)
# Format: https://your-api-domain.com/api/v1/webhooks/plaid
PLAID_WEBHOOK_URL=

# Webhook verification key from Plaid dashboard (optional in sandbox/development)
PLAID_WEBHOOK_VERIFICATION_KEY=

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# REQUIRED: Secret key for JWT token signing
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Must be at least 32 characters and not a placeholder value
SECRET_KEY=GENERATE_SECURE_RANDOM_STRING_MIN_32_CHARS

# JWT algorithm (do not change unless you know what you're doing)
ALGORITHM=HS256

# JWT access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS allowed origins (comma-separated list)
# REQUIRED in production environment
# Development default (if not set): http://localhost:3000,http://localhost:5173
# Production example: https://app.example.com,https://www.example.com
CORS_ORIGINS=

# Logging secret for hashing sensitive identifiers in logs
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# REQUIRED in production for GDPR-compliant log correlation
LOGGING_SECRET=

# -----------------------------------------------------------------------------
# Error Tracking (Optional)
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking and monitoring
# Get from: https://sentry.io/settings/projects/
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
